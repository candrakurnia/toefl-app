DATABASE_URL=postgresql://toefl:toefl@localhost:5432/toefl
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Speaking uploads. Unset uses apps/api/uploads (gitignored).
# Relative paths resolve from apps/api. Files are stored at speaking/<mediaId>.<ext>.
MEDIA_DIR=uploads

# Optional S3-compatible storage (AWS S3 or Cloudflare R2).
# When S3_BUCKET, S3_ACCESS_KEY_ID, and S3_SECRET_ACCESS_KEY are all set, uploads go
# there instead of MEDIA_DIR. GET /media/:id still streams the bytes; objects stay private.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Practice scorer for essay and speaking. Not a model.
# Set SCORING_STUB=false to leave scoring:jobs on Redis for a future model worker.
# SCORING_STUB=true
# Milliseconds a new attempt stays pending before the practice score is written.
# SCORING_STUB_DELAY_MS=4000

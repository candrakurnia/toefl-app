# Browser calls the Next.js rewrite, which proxies to the API. Same-origin keeps the refresh cookie.
NEXT_PUBLIC_API_BASE_URL=/backend
# Server-side rewrite target (not exposed to the browser).
API_PROXY_TARGET=http://localhost:3001
# Sample exams when the API cannot be reached.
# 1 = always sample data, 0 = never, fallback = only after a network or proxy failure.
# Development defaults to fallback. Production stays on the real API unless this is set.
# NEXT_PUBLIC_USE_API_MOCK=fallback
